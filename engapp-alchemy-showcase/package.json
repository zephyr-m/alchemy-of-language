    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dexie": "^4.4.6",
    "reka-ui": "2.10.4",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vue": "3.5.42",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/neucha": "^5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.4",
    "@vitejs/plugin-vue": "6.0.8",
    "shadcn-vue": "2.8.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vue-tsc": "3.3.11"
