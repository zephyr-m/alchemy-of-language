{
  "name": "engapp-alchemy-showcase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 0.0.0.0",
    "build": "vue-tsc -b && vite build --configLoader runner",
